function addFund(p){const name=String(p.name||'').trim();if(!name)return{ok:false,error:'Nama pos kosong'};const ss=SpreadsheetApp.openById(SPREADSHEET_ID),s=fundSheet_(ss),names=s.getLastRow()>1?s.getRange(2,2,s.getLastRow()-1,1).getValues().map(r=>String(r[0]).trim().toLowerCase()):[];if(names.indexOf(name.toLowerCase())>=0)return{ok:false,error:'Pos sudah ada'};s.appendRow(['FUND_'+Date.now(),name,Number(p.opening)||0,0,0,Number(p.opening)||0,true,new Date(),0,0]);rebuildFunds_(ss);return{ok:true,name}}
