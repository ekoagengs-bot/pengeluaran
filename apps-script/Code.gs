function getTransactions(){const ss=SpreadsheetApp.openById(SPREADSHEET_ID),s=ss.getSheetByName(SHEET_TX);if(!s||s.getLastRow()<2)return{ok:true,data:[],count:0,source:'Google Sheet'};const m=map_(s),rows=s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues(),tz=Session.getScriptTimeZone()||'Asia/Jakarta';const fmt=x=>{if(x instanceof Date&&!isNaN(x))return Utilities.formatDate(x,tz,'yyyy-MM-dd');const a=String(x||'').trim().match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);if(a)return a[1]+'-'+String(a[2]).padStart(2,'0')+'-'+String(a[3]).padStart(2,'0');const b=String(x||'').trim().match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);if(b){let y=+b[3];if(y<100)y+=2000;return y+'-'+String(b[2]).padStart(2,'0')+'-'+String(b[1]).padStart(2,'0')}return''};const data=rows.map(r=>{const f=String(v_(r,m,'POS DANA')||'').trim();return{id:String(v_(r,m,'ID TRANSAKSI')||''),date:fmt(v_(r,m,'TANGGAL')),type:String(v_(r,m,'JENIS')||'expense').toLowerCase()==='income'?'income':'expense',merchant:String(v_(r,m,'TOKO/SUMBER')||''),description:String(v_(r,m,'KETERANGAN')||''),category:String(v_(r,m,'KATEGORI')||'Lainnya'),amount:Number(v_(r,m,'NOMINAL'))||0,paymentMethod:String(v_(r,m,'METODE BAYAR')||''),ocrConfidence:String(v_(r,m,'OCR CONFIDENCE')||''),ocrText:String(v_(r,m,'OCR TEXT')||''),receiptUrl:String(v_(r,m,'LINK STRUK')||''),source:String(v_(r,m,'SUMBER')||APP_NAME),fund:FUND_SET[f]?f:'',fundSource:FUND_SET[f]?f:'',incomeType:String(v_(r,m,'JENIS PEMASUKAN')||''),goldGrams:Number(v_(r,m,'GRAM EMAS'))||0,goldPrice:Number(v_(r,m,'HARGA EMAS/GRAM'))||0,goldValue:Number(v_(r,m,'NILAI EMAS'))||0,goldValuation:String(v_(r,m,'METODE VALUASI')||''),goldPriceDate:String(v_(r,m,'TANGGAL HARGA EMAS')||''),synced:true}}).filter(x=>x.id&&x.date);return{ok:true,data,count:data.length,source:'Google Sheet',spreadsheetId:SPREADSHEET_ID}}
function rebuildFunds_(ss){const fs=fundSheet_(ss),tx=ss.getSheetByName(SHEET_TX);seedFunds_(fs);const n=fs.getLastRow()-1;if(n<1)return;const fd=fs.getRange(2,1,n,FUND_HEADERS.length).getValues(),m=tx?map_(tx):{},rows=tx&&tx.getLastRow()>1?tx.getRange(2,1,tx.getLastRow()-1,tx.getLastColumn()).getValues():[],tot={};rows.forEach(r=>{const f=String(v_(r,m,'POS DANA')||'').trim();if(!FUND_SET[f])return;tot[f] ||= {income:0,expense:0,grams:0};const typ=String(v_(r,m,'JENIS')||'expense').toLowerCase(),a=Number(v_(r,m,'NOMINAL'))||0,g=Number(v_(r,m,'GRAM EMAS'))||0;if(typ==='income')tot[f].income+=a;else tot[f].expense+=a;if(GOLD_FUNDS.indexOf(f)>=0)tot[f].grams+=typ==='income'?g:-g});const gp=getGoldPrice_().buyback;const out=fd.map(r=>{const f=String(r[1]),t=tot[f]||{income:0,expense:0,grams:0},opening=Number(r[2])||0,g=GOLD_FUNDS.indexOf(f)>=0?t.grams:0;return[r[0],f,opening,t.income,t.expense,opening+t.income-t.expense,r[6]!==false,r[7]||new Date(),g,GOLD_FUNDS.indexOf(f)>=0?g*gp:0]});fs.getRange(2,1,out.length,FUND_HEADERS.length).setValues(out)}
