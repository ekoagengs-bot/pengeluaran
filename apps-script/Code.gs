function fmt_(tx,fs,sm){[tx,fs,sm].forEach(s=>s.getRange(1,1,1,s.getLastColumn()).setFontWeight('bold').setHorizontalAlignment('center'));const m=map_(tx);if(tx.getMaxRows()>1){if(m['NOMINAL'])tx.getRange(2,m['NOMINAL'],tx.getMaxRows()-1,1).setNumberFormat('#,##0');if(m['GRAM EMAS'])tx.getRange(2,m['GRAM EMAS'],tx.getMaxRows()-1,1).setNumberFormat('0.0000');if(m['HARGA EMAS/GRAM'])tx.getRange(2,m['HARGA EMAS/GRAM'],tx.getMaxRows()-1,1).setNumberFormat('#,##0');if(m['NILAI EMAS'])tx.getRange(2,m['NILAI EMAS'],tx.getMaxRows()-1,1).setNumberFormat('#,##0')}}
function getGoldPrice_(){const props=PropertiesService.getScriptProperties(),key='MONIKAS_GOLD_PRICE',cached=props.getProperty(key);try{const r=UrlFetchApp.fetch('https://www.logammulia.com/id/harga-emas-hari-ini',{muteHttpExceptions:true,followRedirects:true,headers:{'User-Agent':'Mozilla/5.0'}}),h=r.getContentText();let sell=0,buy=0,m=h.match(/1\s*gr[^0-9]{0,250}([0-9][0-9.,]{5,})/i);if(m)sell=money_(m[1]);m=h.match(/buyback[^0-9]{0,250}([0-9][0-9.,]{5,})/i);if(m)buy=money_(m[1]);if(!(sell>0))sell=2624000;if(!(buy>0))buy=2477000;const x={ok:true,source:'ANTAM Logam Mulia',sell,buyback:buy,date:today_(),updatedAt:new Date().toISOString(),url:'https://www.logammulia.com/id/harga-emas-hari-ini'};props.setProperty(key,JSON.stringify(x));return x}catch(e){if(cached)try{return JSON.parse(cached)}catch(z){}return{ok:true,source:'fallback',sell:2624000,buyback:2477000,date:today_(),updatedAt:new Date().toISOString()}}}
