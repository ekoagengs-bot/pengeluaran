function rebuildSummary_(ss){const s=summarySheet_(ss);s.clearContents();s.getRange(1,1,1,SUMMARY_HEADERS.length).setValues([SUMMARY_HEADERS]);const tx=ss.getSheetByName(SHEET_TX);if(!tx||tx.getLastRow()<2)return;const m=map_(tx),rows=tx.getRange(2,1,tx.getLastRow()-1,tx.getLastColumn()).getValues(),agg={};rows.forEach(r=>{const d=parseDate_(v_(r,m,'TANGGAL'));if(!d)return;const k=Utilities.formatDate(d,Session.getScriptTimeZone()||'Asia/Jakarta','yyyy-MM');agg[k] ||= {i:0,e:0,c:0};const a=Number(v_(r,m,'NOMINAL'))||0;if(String(v_(r,m,'JENIS')).toLowerCase()==='income')agg[k].i+=a;else agg[k].e+=a;agg[k].c++});const out=Object.keys(agg).sort().reverse().map(k=>[k,agg[k].i,agg[k].e,agg[k].i-agg[k].e,agg[k].c,agg[k].i?agg[k].e/agg[k].i:0]);if(out.length)s.getRange(2,1,out.length,6).setValues(out)}
function parseDate_(v){if(v instanceof Date&&!isNaN(v))return v;const s=String(v||'').trim();let m=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);if(m)return new Date(+m[1],+m[2]-1,+m[3]);m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);if(m){let y=+m[3];if(y<100)y+=2000;return new Date(y,+m[2]-1,+m[1])}return null}
